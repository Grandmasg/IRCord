# Discord Bot Token & Webhook Secret
DISCORD_BOT_TOKEN=jouw_discord_bot_token_hier
GITHUB_WEBHOOK_SECRET=jouw_geheime_webhook_token_hier

# IRC Instellingen
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=IRCordBot
IRC_USER=ircord
IRC_REALNAME=IRCord Hybrid AI Daemon
IRC_PASSWORD=

# IRCv3 SASL Authenticatie (vóór NICK registratie voor +r kanalen)
IRC_SASL_USER=IRCordBot
IRC_SASL_PASS=

# SQLite Database Pad
DATABASE_URL=sqlite:ircord.db

# ==============================================================================
# DOCKER SERVER KEUZE (APARTE COMPOSE BESTANDEN PER VERSIE)
# ==============================================================================
# Kies eenvoudig welke setup je wilt starten via het bijbehorende bestand:
# 1. Standaard (Ollama + GPU + Auto Model Install): docker compose up -d
# 2. FlashML FreeToken ROCm engine:                docker compose -f docker-compose.freetoken.yml up -d
# 3. Standalone IRCord (AI draait al op host/LAN): docker compose -f docker-compose.standalone.yml up -d

# Docker image voor Ollama:
# - ollama/ollama:rocm -> Voor Minisforum N5 Pro / AMD Ryzen AI / Radeon 890M iGPU
# - ollama/ollama      -> Standaard voor CPU of Nvidia GPU
OLLAMA_IMAGE=ollama/ollama:rocm

# ==============================================================================
# LOKALE AI ENGINE & MODEL INSTELLINGEN (GPU VERSNELD & VLOEIEND NEDERLANDS)
# ==============================================================================
# - Binnen Docker Compose met Ollama profiel:   http://ollama:11434/v1
# - Binnen Docker Compose met FreeToken:        http://freetoken:1919/v1
# - Binnen Docker naar server op Host:          http://host.docker.internal:11434/v1
# - Buiten Docker (Native Rust op Host):        http://127.0.0.1:11434/v1
FREETOKEN_BASE_URL=http://ollama:11434/v1

# AANBEVOLEN MODELLEN VOOR GPU (Minisforum N5 Pro / AMD Ryzen AI / Radeon iGPU):
# 1. qwen2.5:7b          -> [AANBEVOLEN #1 CHAT] Vloeiend Nederlands, strakke instructies, ~4.8 GB VRAM
# 2. qwen2.5-vl:7b       -> [AANBEVOLEN ALLES-IN-ÉÉN] Tekst + Beeldanalyse (Alt-Text) in 1 enkel model! (~5.5 GB)
# 3. deepseek-r1:8b      -> [REDENEREN & CODE] Chain-of-Thought logica en diepe analyses (~5.2 GB VRAM)
# 4. qwen2.5:3b          -> [ULTRA-LICHT] Draait op minimale resources (<2.5 GB VRAM) met goed Nederlands
# 5. llama3.2:3b         -> [META ALTERNATIEF] Zeer snelle lichte chat
FREETOKEN_MODEL=qwen2.5:7b

# Optionele API key (vereist bij sommige vLLM, LiteLLM of externe endpoints)
FREETOKEN_API_KEY=

# ==============================================================================
# EXTERNE API KEYS (OPTIONEEL MAAR AANBEVOLEN VOOR HOOG VOLUME & PRODUCTIE)
# ==============================================================================

# 1. Google YouTube Data API v3 (voor betrouwbare !yt zoekopdrachten zonder scraping)
# Verkrijgbaar via Google Cloud Console: https://console.cloud.google.com/
# Indien leeg: valt terug op YouTube oEmbed + HTML parser (gratis)
YOUTUBE_API_KEY=

# 2. Google Custom Search Engine (voor !g en !google)
# Verkrijgbaar via: https://programmablesearchengine.google.com/
# Indien leeg: valt terug op DuckDuckGo scraper (gratis)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 3. Open-Meteo Weather & Geocoding API (voor !weer en !tijd)
# Let op: Het gratis open-access model (zonder key) heeft strikte limieten (600/min,
# 5.000/uur, 10.000/dag) en is strikt NIET toegestaan voor commercieel gebruik.
# Bovendien worden datacenter- en VPS-IP's (Hetzner, OVH, AWS, DO, etc.) op de publieke
# endpoints vaak direct geratelimited of geblokkeerd door Open-Meteo.
# Vul daarom hier je Open-Meteo API key in voor gegarandeerde uptime en toegang
# tot de dedicated customer endpoints (customer-api en customer-geocoding-api):
# https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# 4. CoinGecko API (voor !crypto)
# Werkt standaard zonder key op openbare endpoints
# Demo of Pro key voor hogere rate limits: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# 5. WhatPulse Web API v1 & Client API (voor !wp <user>, !wp me, en live stats)
# A) Officiële Web API v1 Bearer Token: https://whatpulse.org/settings/api
WHATPULSE_API_KEY=
# B) Optioneel: Lokale Client API URL (standaard: http://localhost:3490/v1/account-totals)
WHATPULSE_CLIENT_URL=http://localhost:3490/v1/account-totals

# 6. DeepL Translation API (voor !tr / !translate)
# Optionele DeepL API key (zowel Free ":fx" als Pro keys worden automatisch herkend)
# https://www.deepl.com/pro-api
# Indien leeg: gebruikt eerst lokale FreeToken AI, met fallback naar MyMemory
DEEPL_API_KEY=

# 7. GitHub API Token (voor !gh / !github repository zoekopdrachten)
# Optioneel: Verhoogt rate-limit van 60 naar 5.000 requests/uur.
# Maak gratis aan op: https://github.com/settings/tokens
GITHUB_TOKEN=

# ==============================================================================
# OVERIGE INGEBOUWDE PLUGINS (100% KOSTENVRIJ, GEEN SLEUTEL VEREIST):
# - !link & !whois: Cross-platform identiteitskoppeling & profielen
# - !bridge stats: Bridge berichtvolume & top-chatters
# - !nas / !hw: Minisforum N5 Pro hardware telemetrie & Radeon 890M GPU monitor
# - !dns, !ssl, !http: Cloudflare DoH & veilige netwerkdiagnose
# - !rss: RSS/Atom nieuwsfeeds monitor & achtergrond broadcast
# - !gh / !github: GitHub repository info & release tracking (gratis zonder token)
# - !cve / !security: Officiële Google OSV.dev & NIST kwetsbaarheden
# - !bday / !verjaardag: Verjaardagstracker & geautomatiseerde felicitaties
# - !wiki: Officiële Wikipedia REST API (vrij toegankelijk)
# - !ud: Urban Dictionary openbare API (vrij toegankelijk)
# - !mc: mcstatus.io Minecraft API (vrij toegankelijk)
# - !valuta / !fx: Frankfurter ECB wisselkoersen (open-source & vrij)
# - !tr: Lokale FreeToken AI met fallback naar MyMemory API
# ==============================================================================

