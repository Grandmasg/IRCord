# Discord Bot Token & Webhook Secret
DISCORD_BOT_TOKEN=your_discord_bot_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# IRC Settings
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=IRCordBot
IRC_USER=ircord
IRC_REALNAME=IRCord Hybrid AI Daemon
IRC_PASSWORD=

# IRCv3 SASL Authentication (prior to NICK registration for +r channels)
IRC_SASL_USER=IRCordBot
IRC_SASL_PASS=

# SQLite Database Path
DATABASE_URL=sqlite:ircord.db

# ==============================================================================
# DOCKER SERVER SELECTION (SEPARATE COMPOSE FILES PER VERSION)
# ==============================================================================
# Choose which stack to launch using its dedicated compose file:
# 1. Standard (Ollama + GPU + Auto Model Install): docker compose up -d
# 2. FlashML FreeToken ROCm engine:                docker compose -f docker-compose.freetoken.yml up -d
# 3. Standalone IRCord (AI already on host/LAN):   docker compose -f docker-compose.standalone.yml up -d

# Docker image for Ollama:
# - ollama/ollama:rocm -> For Minisforum N5 Pro / AMD Ryzen AI / Radeon 890M iGPU
# - ollama/ollama      -> Standard for CPU or Nvidia GPU
OLLAMA_IMAGE=ollama/ollama:rocm

# ==============================================================================
# LOCAL AI ENGINE & MODEL SETTINGS (GPU ACCELERATED & FLUENT DUTCH/MULTILINGUAL)
# ==============================================================================
# - Inside Docker Compose with Ollama profile:   http://ollama:11434/v1
# - Inside Docker Compose with FreeToken:        http://freetoken:1919/v1
# - Inside Docker targeting Host AI server:      http://host.docker.internal:11434/v1
# - Outside Docker (Native Rust on Host):        http://127.0.0.1:11434/v1
FREETOKEN_BASE_URL=http://ollama:11434/v1

# RECOMMENDED MODELS FOR GPU (Minisforum N5 Pro / AMD Ryzen AI / Radeon iGPU):
# 1. qwen2.5:7b          -> [RECOMMENDED #1 CHAT] Fluent Dutch, great instruction following, ~4.8 GB VRAM
# 2. qwen2.5-vl:7b       -> [RECOMMENDED ALL-IN-ONE] Text + Vision (Alt-Text) in 1 single model! (~5.5 GB)
# 3. deepseek-r1:8b      -> [REASONING & CODE] Chain-of-Thought deep analysis (~5.2 GB VRAM)
# 4. qwen2.5:3b          -> [ULTRA-LIGHTWEIGHT] Minimal resources (<2.5 GB VRAM) with great Dutch comprehension
# 5. llama3.2:3b         -> [META LIGHTWEIGHT] Fast English/multilingual chat
FREETOKEN_MODEL=qwen2.5:7b

# Optional API key (required for some vLLM, LiteLLM, or external endpoints)
FREETOKEN_API_KEY=

# ==============================================================================
# EXTERNAL API KEYS (OPTIONAL, RECOMMENDED FOR PRODUCTION & HIGH VOLUME)
# ==============================================================================

# 1. Google YouTube Data API v3 (for reliable !yt search without scraping)
# Obtain from Google Cloud Console: https://console.cloud.google.com/
# If empty: falls back to YouTube oEmbed + HTML parser (free)
YOUTUBE_API_KEY=

# 2. Google Custom Search Engine (for !g and !google)
# Obtain from: https://programmablesearchengine.google.com/
# If empty: falls back to DuckDuckGo scraper (free)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 3. Open-Meteo Weather & Geocoding API (for !weather and !time)
# Note: The free open-access tier has strict limits (600/min, 5,000/hr, 10,000/day)
# and strictly prohibits commercial use.
# Furthermore, datacenter and VPS IPs (Hetzner, OVH, AWS, DigitalOcean, etc.) are
# frequently rate-limited or blocked on public endpoints by Open-Meteo.
# Provide your Open-Meteo API key here for guaranteed uptime and access to dedicated
# customer endpoints (customer-api and customer-geocoding-api):
# https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# 4. CoinGecko API (for !crypto)
# Works without key on public endpoints by default.
# Demo or Pro key for higher rate limits: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# 5. WhatPulse Web API v1 & Client API (for !wp <user>, !wp me, and live stats)
# A) Official Web API v1 Bearer Token: https://whatpulse.org/settings/api
WHATPULSE_API_KEY=
# B) Optional: Local Client API URL (default: http://localhost:3490/v1/account-totals)
WHATPULSE_CLIENT_URL=http://localhost:3490/v1/account-totals

# 6. DeepL Translation API (for !tr / !translate)
# Optional DeepL API key (both Free ":fx" and Pro keys are automatically detected)
# https://www.deepl.com/pro-api
# If empty: uses local FreeToken AI first, with fallback to MyMemory API
DEEPL_API_KEY=

# 7. GitHub API Token (for !gh / !github repository lookup)
# Optional: Increases rate limit from 60 to 5,000 requests/hour.
# Obtain a fine-grained or classic token from: https://github.com/settings/tokens
GITHUB_TOKEN=

# ==============================================================================
# OTHER BUILT-IN PLUGINS (100% FREE, NO KEY REQUIRED):
# - !link & !whois: Cross-platform identity linking & profile lookup
# - !bridge stats: Bridge message volume & top chatters
# - !nas / !hw: Minisforum N5 Pro hardware telemetry & Radeon 890M GPU monitor
# - !dns, !ssl, !http: Cloudflare DoH & safe network diagnostics
# - !rss: RSS/Atom feeds monitor & background broadcast poller
# - !gh / !github: GitHub repository info & release tracking (free without key)
# - !cve / !security: Official Google OSV.dev & NIST vulnerability advisories
# - !bday / !verjaardag: Birthday tracker & automated morning greeter
# - !wiki: Official Wikimedia REST API (freely accessible)
# - !ud: Urban Dictionary public API (freely accessible)
# - !mc: mcstatus.io Minecraft API (freely accessible)
# - !currency / !valuta / !fx: Frankfurter ECB exchange rates (open source & free)
# - !tr: Local FreeToken AI with fallback to MyMemory API
# ==============================================================================

