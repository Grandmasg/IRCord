# Discord Bot-Token & Webhook-Secret
DISCORD_BOT_TOKEN=dein_discord_bot_token_hier
GITHUB_WEBHOOK_SECRET=dein_geheimes_webhook_secret_hier

# IRC-Einstellungen
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=IRCordBot
IRC_USER=ircord
IRC_REALNAME=IRCord Hybrid AI Daemon
IRC_PASSWORD=

# IRCv3 SASL-Authentifizierung (vor NICK-Registrierung für +r Kanäle)
IRC_SASL_USER=IRCordBot
IRC_SASL_PASS=

# SQLite-Datenbankpfad
DATABASE_URL=sqlite:ircord.db

# ==============================================================================
# DOCKER SERVER-AUSWAHL (SEPARATE COMPOSE-DATEIEN PRO VERSION)
# ==============================================================================
# Wähle dein gewünschtes Setup über die passende Docker-Compose-Datei:
# 1. Standard (Ollama + GPU + Auto-Model-Install): docker compose up -d
# 2. FlashML FreeToken ROCm-Engine:               docker compose -f docker-compose.freetoken.yml up -d
# 3. Standalone IRCord (AI läuft auf Host/LAN):   docker compose -f docker-compose.standalone.yml up -d

# Docker-Image für Ollama:
# - ollama/ollama:rocm -> Für Minisforum N5 Pro / AMD Ryzen AI / Radeon 890M iGPU
# - ollama/ollama      -> Standard für CPU oder Nvidia GPU
OLLAMA_IMAGE=ollama/ollama:rocm

# ==============================================================================
# LOKALE AI ENGINE & MODELL-EINSTELLUNGEN (GPU-BESCHLEUNIGT)
# ==============================================================================
# - Innerhalb von Docker Compose mit Ollama-Profil: http://ollama:11434/v1
# - Innerhalb von Docker Compose mit FreeToken:      http://freetoken:1919/v1
# - Innerhalb von Docker zum Host-Server:           http://host.docker.internal:11434/v1
# - Außerhalb von Docker (Native Rust auf Host):    http://127.0.0.1:11434/v1
FREETOKEN_BASE_URL=http://ollama:11434/v1

# EMPFOHLENE MODELLE FÜR GPU (Minisforum N5 Pro / AMD Ryzen AI / Radeon iGPU):
# 1. qwen2.5:7b          -> [EMPFOHLEN #1 CHAT] Fließendes Deutsch, präzise Anweisungen, ~4.8 GB VRAM
# 2. qwen2.5-vl:7b       -> [ALL-IN-ONE EMPFEHLUNG] Text + Bildanalyse (Alt-Text) in 1 Modell! (~5.5 GB)
# 3. deepseek-r1:8b      -> [LOGIK & CODE] Chain-of-Thought Denkmuster und tiefe Analysen (~5.2 GB VRAM)
# 4. qwen2.5:3b          -> [ULTRA-LEICHT] Läuft mit minimalen Ressourcen (<2.5 GB VRAM) mit gutem Deutsch
# 5. llama3.2:3b         -> [META-ALTERNATIVE] Sehr schneller, schlanker Chat
FREETOKEN_MODEL=qwen2.5:7b

# Optionaler API-Key (erforderlich bei vLLM, LiteLLM oder externen Endpunkten)
FREETOKEN_API_KEY=

# ==============================================================================
# EXTERNE API-SCHLÜSSEL (OPTIONAL, ABER EMPFOHLEN FÜR HOHE ANFRAGEVOLUMINA)
# ==============================================================================

# 1. Google YouTube Data API v3 (für zuverlässige !yt-Suchanfragen ohne Scraping)
# Erhältlich in der Google Cloud Console: https://console.cloud.google.com/
# Falls leer: Fallback auf YouTube oEmbed + HTML-Parser (kostenlos)
YOUTUBE_API_KEY=

# 2. Google Custom Search Engine (für !g und !google)
# Erhältlich über: https://programmablesearchengine.google.com/
# Falls leer: Fallback auf DuckDuckGo-Scraper (kostenlos)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# 3. Open-Meteo Wetter- & Geocoding-API (für !wetter und !zeit)
# Hinweis: Das kostenlose Open-Access-Modell (ohne Key) hat Limits (600/Min,
# 5.000/Std, 10.000/Tag) und ist für kommerzielle Zwecke nicht gestattet.
# Zudem werden Datacenter-/VPS-IPs (Hetzner, OVH, AWS etc.) auf den öffentlichen
# Endpunkten häufig sofort ratelimited.
# Trage hier deinen Open-Meteo API-Key für garantierte Erreichbarkeit ein:
# https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# 4. CoinGecko API (für !crypto)
# Funktioniert standardmäßig ohne Key auf öffentlichen Endpunkten
# Demo- oder Pro-Key für höhere Limits: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# 5. WhatPulse Web API v1 & Client API (für !wp <user>, !wp me und Live-Statistiken)
# A) Offizieller Web-API v1 Bearer Token: https://whatpulse.org/settings/api
WHATPULSE_API_KEY=
# B) Optional: Lokale Client-API URL (Standard: http://localhost:3490/v1/account-totals)
WHATPULSE_CLIENT_URL=http://localhost:3490/v1/account-totals

# 6. DeepL Übersetzungs-API (für !tr / !translate)
# Optionaler DeepL API-Key (sowohl Free ":fx" als auch Pro Keys werden unterstützt)
# https://www.deepl.com/pro-api
# Falls leer: Verwendet zuerst lokale FreeToken AI, mit Fallback auf MyMemory
DEEPL_API_KEY=

# 7. GitHub API Token (für !gh / !github Repository-Suche)
# Optional: Erhöht das Limit von 60 auf 5.000 Anfragen/Stunde.
# Kostenlos erstellbar unter: https://github.com/settings/tokens
GITHUB_TOKEN=

# ==============================================================================
# WEITERE INTEGRIERTE PLUGINS (100% KOSTENLOS, KEIN SCHLÜSSEL ERFORDERLICH):
# - !link & !whois: Plattformübergreifende Identitätsverknüpfung & Profile
# - !bridge stats: Bridge-Nachrichtenvolumen & Top-Chatter
# - !nas / !hw: Minisforum N5 Pro Hardware-Telemetrie & Radeon 890M GPU Monitor
# - !dns, !ssl, !http: Cloudflare DoH & sichere Netzwerkdiagnose
# - !rss: RSS/Atom Newsfeeds-Monitor & Hintergrund-Broadcast
# - !gh / !github: GitHub Repository-Infos & Release-Tracking (kostenlos ohne Token)
# - !cve / !security: Offizielle Google OSV.dev & NIST Sicherheitslücken
# - !bday / !geburtstag: Geburtstagstracker & automatische Glückwünsche
# - !wiki: Offizielle Wikipedia REST API (frei zugänglich)
# - !ud: Urban Dictionary öffentliche API (frei zugänglich)
# - !mc: mcstatus.io Minecraft API (frei zugänglich)
# - !waehrung / !kurs: Frankfurter EZB-Wechselkurse (Open-Source & frei)
# - !tr: Lokale FreeToken AI mit Fallback auf MyMemory API
# ==============================================================================
